# NX789J - recovery USB.
#
# bootable/recovery/etc/init.rc imports /init.recovery.${ro.hardware}.rc as its
# first line, which is how a device hooks recovery's init. ro.hardware is qcom.
#
# That same file already contains the COMPLETE ConfigFS gadget setup, guarded by
#     on fs && property:sys.usb.configfs=1
# (mkdir g1, strings/0x409, functions/ffs.adb, configs/b.1, MaxPower) plus the
# /dev/usb-ffs/adb functionfs mount. Nothing else is missing. But it defaults
#     setprop sys.usb.configfs 0
# in "on early-init", and stock flips it to 1 from
# vendor/etc/init/hw/init.qcom.usb.rc - a file this port does not ship. With it
# left at 0 recovery takes the legacy android_usb branch instead, which is why
# recovery logged, forever:
#     failed to open /sys/class/android_usb/android0/state: No such file or
#     directory
# and adb never enumerated even though it said "Enabled ADB."
#
# "on init" runs after "on early-init" (so it wins over the 0) and before "on fs"
# (so the guard is already 1 when recovery builds the gadget).
on init
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    setprop sys.usb.configfs 1

# Diagnostics. See /nx789j-diag.sh for why this exists - with no USB in recovery
# and no kernel log in the on-screen viewer, dumping to a raw partition and
# reading it back over EDL is the only channel available.
# REMOVE THIS once recovery adb works.
service nxdiag /system/bin/sh /nx789j-diag.sh
    disabled
    oneshot

on property:sys.usb.configfs=1
    start nxdiag
