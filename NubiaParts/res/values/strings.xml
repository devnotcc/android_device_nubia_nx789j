    <string name="linux_category">Debian</string>
    <string name="linux_boot_title">Restart into Debian</string>
    <string name="linux_checking">Checking whether Debian is installed…</string>
    <string name="linux_ready">Starts the Debian desktop for one boot. To come back, use Restart into Android in Debian’s app menu, or just restart the phone.</string>
