    <string name="linux_missing">Debian isn’t installed. Install it with the NX789J Installer on a PC.</string>
    <string name="linux_nohook">Debian is installed, but its boot script has never run (it needs KernelSU). Restarting would come back to Android.</string>
    <string name="linux_unknown">Couldn’t check whether Debian is installed.</string>
    <string name="linux_confirm_title">Restart into Debian?</string>
    <string name="linux_confirm_message">The phone restarts now and starts Debian instead of Android. Calls, messages and Android apps are unavailable until you restart back into Android.</string>
