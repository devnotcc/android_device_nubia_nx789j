<resources>
    <!-- Refresh rate: two lists instead of the "Smooth display" switch.
         LineageOS Settings has "Max refresh rate"
         (PeakRefreshRateListPreferenceController, writes peak_refresh_rate) and
         "Min refresh rate" (MinRefreshRatePreferenceController, writes
         min_refresh_rate), both hidden unless enabled here. With min 60 / max 144
         the panel drops to 60 Hz when idle through SurfaceFlinger's idle timer
         (properties/system_ext.prop). -->
    <bool name="config_show_smooth_display">false</bool>
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <bool name="config_show_min_refresh_rate_switch">true</bool>
</resources>
