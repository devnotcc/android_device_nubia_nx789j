+  static bool IsCodecCompatibleWithRunningStream(LeAudioDeviceGroup* group,
+                                                  const bluetooth::le_audio::types::AudioSetConfiguration& conf) {
+    for (auto direction : {bluetooth::le_audio::types::kLeAudioDirectionSink,
+                           bluetooth::le_audio::types::kLeAudioDirectionSource}) {
+      const auto& params = group->stream_conf.stream_params.get(direction);
+      if (params.num_of_devices == 0) {
+        continue;
+      }
+      const auto& running = params.stream_config;
+      for (const auto& ent : conf.confs.get(direction)) {
+        const auto& core = ent.codec.params.GetAsCoreCodecConfig();
+        if ((core.sampling_frequency && running.sampling_frequency_hz &&
+             core.GetSamplingFrequencyHz() != running.sampling_frequency_hz) ||
+            (core.frame_duration && running.frame_duration_us &&
+             core.GetFrameDurationUs() != running.frame_duration_us) ||
+            (core.octets_per_codec_frame && running.octets_per_codec_frame &&
+             *core.octets_per_codec_frame != running.octets_per_codec_frame) ||
+            (core.codec_frames_blocks_per_sdu && running.codec_frames_blocks_per_sdu &&
+             *core.codec_frames_blocks_per_sdu != running.codec_frames_blocks_per_sdu)) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
