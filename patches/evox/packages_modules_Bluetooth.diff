+  /* The Qualcomm offload Audio HAL does not always send empty sink metadata when a call record
+   * track goes away (e.g. a WhatsApp call whose microphone never ran over LE Audio). The stale
+   * CONVERSATIONAL decoding metadata then kept music on the call configuration (32 kHz mono)
+   * until the headset reconnected. Drop it once no call is going on and the local sink is idle.
+   */
+  void ClearStaleCallDecodingMetadata() {
+    if (!com_android_bluetooth_flags_leaudio_use_context_type_manager() || IsInCall() ||
+        IsInVoipCall() || audio_receiver_state_ != AudioState::IDLE ||
+        configuration_context_type_ != LeAudioContextType::CONVERSATIONAL) {
+      return;
+    }
+    log::info("Call is over and local sink is idle, clearing stale decoding metadata");
+    std::vector<record_track_metadata_v7> empty_tracks = {};
+    audioContextTypeManager_->SetDecodingSessionMetadata(empty_tracks);
+  }
