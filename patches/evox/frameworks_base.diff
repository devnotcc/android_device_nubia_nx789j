diff --git a/core/java/com/zte/feature/Feature.java b/core/java/com/zte/feature/Feature.java
new file mode 100755
index 000000000..bfef75528
--- /dev/null
+++ b/core/java/com/zte/feature/Feature.java
@@ -0,0 +1,71 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.zte.feature;
+
+import android.os.SystemProperties;
+import android.text.TextUtils;
+
+import java.util.Locale;
+
+/**
+ * Minimal stand-in for the ZTE framework feature switch (com.zte.feature.Feature in the stock
+ * NX789J framework.jar). nubia apps such as the stock camera look it up by reflection, with keys
+ * that are the feature property names ("ro.vendor.feature.camera_under_screen_sensor") or short
+ * ZTE names ("ZTE_FEATURE_..."). Stock serves them from a cache filled by system_server; here they
+ * are read straight from the properties the stock vendor/odm images already set. Without the
+ * class every feature reads as off - for the camera that means, among others, no under-display
+ * camera mask.
+ *
+ * @hide
+ */
+public final class Feature {
+    private static final String PREFIX = "ro.vendor.feature.";
+
+    private Feature() {}
+
+    private static String lookup(String key) {
+        if (TextUtils.isEmpty(key)) return "";
+        String k = key.toLowerCase(Locale.ENGLISH);
+        String v = SystemProperties.get(k, "");
+        if (v.isEmpty() && !k.startsWith(PREFIX)) v = SystemProperties.get(PREFIX + k, "");
+        return v;
+    }
+
+    public static String get(String key) {
+        return lookup(key);
+    }
+
+    public static String get(String key, String def) {
+        String v = lookup(key);
+        return v.isEmpty() ? def : v;
+    }
+
+    public static boolean getBoolean(String key, boolean def) {
+        String v = lookup(key);
+        if (v.isEmpty()) return def;
+        if ("1".equals(v) || "true".equalsIgnoreCase(v) || "y".equalsIgnoreCase(v)
+                || "yes".equalsIgnoreCase(v) || "on".equalsIgnoreCase(v)) return true;
+        if ("0".equals(v) || "false".equalsIgnoreCase(v) || "n".equalsIgnoreCase(v)
+                || "no".equalsIgnoreCase(v) || "off".equalsIgnoreCase(v)) return false;
+        return def;
+    }
+
+    public static int getInt(String key, int def) {
+        try {
+            return Integer.decode(lookup(key));
+        } catch (NumberFormatException e) {
+            return def;
+        }
+    }
+
+    public static long getLong(String key, long def) {
+        try {
+            return Long.decode(lookup(key));
+        } catch (NumberFormatException e) {
+            return def;
+        }
+    }
+}
diff --git a/media/java/android/media/audiofx/DtsAudio.java b/media/java/android/media/audiofx/DtsAudio.java
new file mode 100755
index 000000000..0a459a6b1
--- /dev/null
+++ b/media/java/android/media/audiofx/DtsAudio.java
@@ -0,0 +1,141 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package android.media.audiofx;
+
+import android.app.ActivityThread;
+import android.app.Application;
+import android.media.AudioDeviceCallback;
+import android.media.AudioDeviceInfo;
+import android.media.AudioManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+
+import java.util.UUID;
+
+/**
+ * Thin AudioEffect wrapper used by the nubia/ZTE DTS:X Ultra app (com.dts.dtsxultra), which
+ * looks this class up by reflection. Same shape as the class in the stock NX789J framework:
+ * it only exposes the AudioEffect constructor and raw parameter calls.
+ *
+ * @hide
+ */
+public class DtsAudio extends AudioEffect {
+    private static final String TAG = DtsAudio.class.getSimpleName();
+
+    // The app asks for audio session -22, which only nubia's modified AudioFlinger accepts (its
+    // DTS hook runs in the mixer). AOSP AudioFlinger rejects it ("invalid sessionId"), so map it
+    // to the global output mix, where the vendor "DTS Audio" effect (libdtsaudioaidl) runs.
+    private static final int NUBIA_DTS_SESSION = -22;
+    private static final int OUTPUT_MIX_SESSION = 0;
+
+    private AudioManager mAudioManager;
+    private AudioDeviceCallback mDeviceCallback;
+
+    public DtsAudio(UUID type, UUID uuid, int priority, int audioSession) {
+        super(type, uuid, priority,
+                audioSession == NUBIA_DTS_SESSION ? OUTPUT_MIX_SESSION
+                        : audioSession);
+        if (audioSession == NUBIA_DTS_SESSION) {
+            startRouteTracking();
+        }
+    }
+
+    /**
+     * nubia's AudioFlinger runs its session -22 hook by itself and only for the routes DTS is
+     * tuned for; the app never calls setEnabled(), it only switches DTS with its own parameter.
+     * On the output mix the effect must be enabled or AudioFlinger never feeds it audio (quiet
+     * speakers), but the global music effect follows music to every output, and its speaker
+     * tuning ruins Bluetooth audio (no bass). The app marks Bluetooth as a route DTS must not
+     * process (disable_route_bluetooth) but cannot see the route on this ROM. So: enabled
+     * unless a Bluetooth audio output is connected (speaker, wired and USB stay processed).
+     */
+    private void startRouteTracking() {
+        Application app = ActivityThread.currentApplication();
+        mAudioManager = app != null ? app.getSystemService(AudioManager.class) : null;
+        if (mAudioManager == null) {
+            Log.w(TAG, "no AudioManager; DTS stays enabled on every route");
+            super.setEnabled(true);
+            return;
+        }
+        mDeviceCallback = new AudioDeviceCallback() {
+            @Override
+            public void onAudioDevicesAdded(AudioDeviceInfo[] added) {
+                updateEnabled();
+            }
+
+            @Override
+            public void onAudioDevicesRemoved(AudioDeviceInfo[] removed) {
+                updateEnabled();
+            }
+        };
+        // the callback fires once at registration with the devices already connected
+        mAudioManager.registerAudioDeviceCallback(mDeviceCallback, new Handler(Looper.getMainLooper()));
+        updateEnabled();
+    }
+
+    private static boolean isBluetoothOutput(int type) {
+        switch (type) {
+            case AudioDeviceInfo.TYPE_BLUETOOTH_A2DP:
+            case AudioDeviceInfo.TYPE_BLUETOOTH_SCO:
+            case AudioDeviceInfo.TYPE_BLE_HEADSET:
+            case AudioDeviceInfo.TYPE_BLE_SPEAKER:
+            case AudioDeviceInfo.TYPE_BLE_BROADCAST:
+            case AudioDeviceInfo.TYPE_HEARING_AID:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private void updateEnabled() {
+        if (mAudioManager == null) return;
+        boolean bluetooth = false;
+        for (AudioDeviceInfo d : mAudioManager.getDevices(AudioManager.GET_DEVICES_OUTPUTS)) {
+            if (isBluetoothOutput(d.getType())) {
+                bluetooth = true;
+                break;
+            }
+        }
+        try {
+            if (hasControl() && getEnabled() == bluetooth) {
+                super.setEnabled(!bluetooth);
+                Log.i(TAG, bluetooth ? "Bluetooth audio connected: DTS off" : "no Bluetooth audio: DTS on");
+            }
+        } catch (IllegalStateException e) {
+            // released meanwhile
+        }
+    }
+
+    @Override
+    public void release() {
+        if (mAudioManager != null && mDeviceCallback != null) {
+            mAudioManager.unregisterAudioDeviceCallback(mDeviceCallback);
+            mDeviceCallback = null;
+        }
+        super.release();
+    }
+
+    @Override
+    public int setEnabled(boolean enabled) {
+        return super.setEnabled(enabled);
+    }
+
+    @Override
+    public boolean getEnabled() {
+        return super.getEnabled();
+    }
+
+    @Override
+    public int setParameter(byte[] param, byte[] value) {
+        return super.setParameter(param, value);
+    }
+
+    @Override
+    public int getParameter(byte[] param, byte[] value) {
+        return super.getParameter(param, value);
+    }
+}
