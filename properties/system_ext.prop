# Dual SIM — vendor declares every android.hardware.radio.* on slot1 + slot2
persist.radio.multisim.config=dsds

# Bluetooth profiles and LE Audio.
# Stock sets these in its OWN system_ext/etc/build.prop and product/etc/build.prop,
# which LineageOS replaces, so on build 22 only GATT and Hearing Aid started:
# Galaxy Buds3 Pro bonded fine but LocalBluetoothProfileManager listed
# "Current Profiles[]" - no A2DP, HFP, AVRCP or LE Audio to connect.
# Values copied verbatim from the stock NX789J images.
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.avrcp.controller.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.sap.server.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.device_id.vendor_id=0x001D
bluetooth.device.class_of_device=90,2,12
bluetooth.hfp.codec_aptx_voice.enabled=true
bluetooth.hfp.swb.aptx.power_management.enabled=true
bluetooth.leaudio.dual_bidirection_swb.supported=true
ro.bluetooth.leaudio_offload.supported=true
persist.bluetooth.leaudio_offload.disabled=false
persist.bluetooth.leaudio.bypass_allow_list=true
persist.bluetooth.leaudio.notify.idle.during.call=true

# Variable refresh rate.
# Stock vendor sets content detection + a 200 ms touch timer but no idle timer
# (ZTE's framework drives refresh switching itself). Without an idle timer
# SurfaceFlinger never leaves the last requested mode, so the panel sat at 144 Hz.
# 300 ms matches the official LineageOS sm8750-common tree. The panel's gamma
# differs per refresh rate, which shows at low brightness; like stock, switching
# is held off there (config_brightnessThresholdsOfPeakRefreshRate in the overlay).
ro.surface_flinger.set_idle_timer_ms=300

# Under-display fingerprint: frame-synchronised global HBM.
# Read by our SurfaceFlinger patch (patches/frameworks_native/0001-...), which
# switches this node around the present of the frame that shows/hides the
# NubiaUdfps mask + circle layers. See NubiaUdfps/UdfpsController.java.
ro.surface_flinger.udfps_hbm_node=/proc/driver/lcd_hbm
# Timing (2026-09-16, 144 Hz lock screen):
#   on_fence=1: wait until the mask frame is on the panel, then lcd_hbm.
#     delay=0 + no fence boosts the still-unmasked frame (max-white flash).
#     a millisecond sleep races vsync and flickers.
#   alpha_offset: stock mask table plus 0.01 (EvoX, 2026-09-25, tuned by eye at
#     brightness 47/255: 0 slightly bright, +0.02 dark; the old +0.06 dimmed the
#     whole screen far too much during a press).
debug.sf.udfps_hbm_on_fence=1
debug.sf.udfps_hbm_on_delay_ms=0
debug.sf.udfps_hbm_off_fence=0
debug.nubia.udfps.alpha_offset=10
debug.nubia.udfps.release_frames=0

# Brightness slider dead zone. The stock display config maps brightness to
# NITS already, and SettingsLib BrightnessUtils applies a second (HLG gamma)
# curve on top, so 0-40% of the QS/Settings slider only spanned ~4.5-7 nits and
# felt dead. Disable that extra conversion (read once by SettingsLib at class load).
sys.brightness.disable_gamma_conversion=1

# Camcorder profiles.
# Stock system/build.prop points media.settings.xml at a file that is not on the
# vendor partition, so MediaProfiles falls back to media_profiles_V1_0.xml, which
# tops out at 1080p - Aperture offered only 480p/720p/1080p. The SM8750 ("sun")
# file carries the 2160p and 4320p profiles.
media.settings.xml=/vendor/etc/media_profiles_sun.xml

# Stock Qualcomm IMS/telephony apps (qti-telephony/) are gated on
# ro.boot.vendor.qspa.modem=enabled, but the ABL passes "0". tools/qti-telephony/patch-qspa.py
# re-points their manifests at this property instead.
ro.system_ext.nx789j.qspa=enabled

# Qualcomm data/telephony props that stock sets on its system and system_ext partitions
# (not on vendor), so without them the stock vendor daemons ran on their defaults.
persist.vendor.data.mode=concurrent
persist.vendor.cne.feature=1
persist.vendor.dpm.feature=11
ro.vendor.use_data_netmgrd=true
ro.telephony.sim_slots.count=2
telephony.active_modems.max_count=2

# AIDL audio HAL vendor parameters (call_state/vsid from QtiTelephonyService for VoLTE,
# BT offload reconfig, ...) go through IHalAdapterVendorExtension, served by
# qtiaudiohalvendorextn. Without both, VoLTE calls connect with no audio either way.
ro.audio.ihaladaptervendorextension_enabled=true
